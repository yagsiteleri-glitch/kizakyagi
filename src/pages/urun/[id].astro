---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProductCard from '../../components/ProductCard.astro';
import products from '../../data/products.json';
import siteConfig from '../../data/siteConfig.json';

export async function getStaticPaths() {
  return products.map((product) => ({
    params: { id: product.id },
    props: { product }
  }));
}

const { product } = Astro.props;

// MSDS & TDS direct PDF or WhatsApp fallback link
const msdsHref = (product.msdsUrl && product.msdsUrl !== '#')
  ? product.msdsUrl
  : `https://wa.me/905069401210?text=${encodeURIComponent(`[hidrolikyag.com] TEKNIK BELGE TALEBI (MSDS)\n\nUrun: ${product.name}\n\nMerhaba, bu urunun guncel MSDS Guvenlik Bilgi Formunu PDF olarak talep ediyorum.`)}`;

const tdsHref = (product.tdsUrl && product.tdsUrl !== '#')
  ? product.tdsUrl
  : `https://wa.me/905069401210?text=${encodeURIComponent(`[hidrolikyag.com] TEKNIK BELGE TALEBI (TDS)\n\nUrun: ${product.name}\n\nMerhaba, bu urunun guncel TDS Teknik Veri Formunu PDF olarak talep ediyorum.`)}`;

const hasDirectMsds = product.msdsUrl && product.msdsUrl !== '#';
const hasDirectTds = product.tdsUrl && product.tdsUrl !== '#';

// Related products: 4 products (same brand first, then other products)
let relatedProducts = products
  .filter(p => p.id !== product.id && p.brand === product.brand)
  .slice(0, 4);

if (relatedProducts.length < 4) {
  const fillers = products.filter(p => p.id !== product.id && !relatedProducts.some(rp => rp.id === p.id));
  relatedProducts = [...relatedProducts, ...fillers].slice(0, 4);
}
---

<Layout
  title={`${product.name} Fiyatı & Teknik Özellikleri | ${siteConfig.siteName}`}
  description={product.shortDescription || `${product.name} orijinal endüstriyel hidrolik yağı. Teknik özellikleri ve toptan teklif.`}
  ogImage={product.image}
>
  <!-- Product Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "image": product.image,
    "description": product.shortDescription || "Orijinal ambalajlı hidrolik yağı. Aynı gün sevkiyat ve toptan iskonto avantajı.",
    "sku": product.id,
    "mpn": product.id,
    "brand": {
      "@type": "Brand",
      "name": product.brandName
    },
    "category": "Endüstriyel Yağlar > Hidrolik Yağı",
    "offers": {
      "@type": "Offer",
      "url": `${siteConfig.domain}/urun/${product.id}`,
      "priceCurrency": "TRY",
      "priceValidUntil": "2027-12-31",
      "itemCondition": "https://schema.org/NewCondition",
      "availability": "https://schema.org/InStock",
      "seller": {
        "@type": "Organization",
        "name": siteConfig.siteName
      }
    }
  })} />

  <!-- White Modern Breadcrumb Bar with Home Icon & Ellipsis -->
  <Breadcrumb
    items={[
      { label: product.brandName, href: `/${product.brand}` },
      { label: product.name }
    ]}
  />

  <!-- Product Main Section -->
  <section class="single-product-wrap">
    <div class="container product-inner-grid">
      <!-- Left: Product Image Box -->
      <div class="single-image-box">
        <span class="img-badge-trust">
          <i class="fas fa-shield-alt"></i> Orijinal Ambalaj
        </span>
        <div class="main-prod-img">
          <img src={product.image} alt={product.name} loading="eager" />
        </div>
      </div>

      <!-- Right: Product Details & Action Buttons -->
      <div class="single-details-box">
        <!-- Top Meta Tags -->
        <div class="product-meta-row">
          <a href={`/${product.brand}`} class="meta-pill brand-pill">
            {product.brandName}
          </a>
          <span class="meta-pill visc-pill">
            {product.viscosity}
          </span>
        </div>

        <h1 class="single-title">{product.name}</h1>
        {product.shortDescription && (
          <p class="single-short-desc">{product.shortDescription}</p>
        )}

        <!-- Quick Specs Summary Bar -->
        <div class="product-specs-summary">
          <div class="spec-summary-item">
            <span class="ss-label">Viskozite</span>
            <strong class="ss-value">{product.viscosity}</strong>
          </div>
          <div class="spec-summary-item">
            <span class="ss-label">Kullanım</span>
            <strong class="ss-value">Hidrolik Sistemler</strong>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="cta-buttons-wrap">
          <a
            href={`https://wa.me/905069401210?text=${encodeURIComponent(`[hidrolikyag.com] URUN FIYAT VE STOK TALEBI\n\nUrun: ${product.name}\nViskozite: ${product.viscosity}\nAmbalaj: ${product.packageSize} ${product.packageType}\n\nMerhaba, bu urun icin guncel fiyat teklifi ve stok durumunu ogrenmek istiyorum.`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="cta-btn-wa"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 18.07c-1.52 0-3-.4-4.3-1.17l-.31-.18-3.19.84.85-3.11-.2-.32c-.85-1.36-1.3-2.94-1.3-4.57 0-4.7 3.83-8.53 8.54-8.53 2.28 0 4.42.89 6.03 2.5 1.61 1.61 2.5 3.75 2.5 6.03 0 4.71-3.83 8.53-8.52 8.53zm4.68-6.39c-.26-.13-1.52-.75-1.76-.84-.23-.09-.4-.13-.57.13-.17.26-.66.84-.81 1.01-.15.17-.3.19-.56.06-.26-.13-1.08-.4-2.06-1.27-.76-.68-1.28-1.52-1.43-1.78-.15-.26-.02-.4.11-.53.12-.11.26-.3.39-.45.13-.15.17-.26.26-.43.09-.17.04-.32-.02-.45-.06-.13-.57-1.38-.79-1.89-.21-.5-.42-.43-.57-.44l-.49-.01c-.17 0-.45.06-.68.32-.23.26-.89.87-.89 2.12 0 1.25.91 2.46 1.04 2.63.13.17 1.8 2.75 4.36 3.86.61.26 1.09.42 1.46.54.61.2 1.17.17 1.61.1.49-.07 1.52-.62 1.74-1.22.21-.6.21-1.12.15-1.22-.06-.1-.23-.17-.49-.3z"/></svg>
            WhatsApp ile Fiyat Al
          </a>
          <div class="cta-secondary-row">
            <a href="tel:+905069401210" class="cta-btn-call">
              <i class="fas fa-phone-alt"></i>
              0506 940 12 10
            </a>
            <a href="/teklif-al" class="cta-btn-detail">
              Kurumsal Teklif
            </a>
          </div>
        </div>

        <!-- Technical Documents -->
        <div class="tech-docs-grid">
          <a href={product.msdsUrl} target="_blank" rel="noopener noreferrer" class="doc-download-pill">
            <div class="doc-icon"><i class="fas fa-file-pdf"></i></div>
            <div class="doc-info">
              <strong>MSDS</strong>
              <small>Güvenlik Bilgi Formu</small>
            </div>
            <i class="fas fa-download doc-dl-icon"></i>
          </a>
          <a href={product.tdsUrl} target="_blank" rel="noopener noreferrer" class="doc-download-pill">
            <div class="doc-icon"><i class="fas fa-file-pdf"></i></div>
            <div class="doc-info">
              <strong>TDS</strong>
              <small>Teknik Veri Formu</small>
            </div>
            <i class="fas fa-download doc-dl-icon"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Description & Specs -->
  <section class="product-long-desc-section">
    <div class="container">
      <div class="desc-divider"></div>
      <h2 class="desc-heading">Ürün Açıklaması</h2>
      <div class="desc-text-body">
        <div class="desc-html-content" set:html={product.description} />

        <h3>Teknik Veri & Viskozite Değerleri</h3>
        <table class="orig-specs-table">
          <tbody>
            {product.specs.map(s => (
              <tr>
                <td><strong>{s.label}</strong></td>
                <td>{s.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Related Products -->
      {relatedProducts.length > 0 && (
        <div class="related-block">
          <h2 class="section-heading">Benzer Ürünler</h2>
          <div class="section-divider-line"></div>
          <div class="related-grid">
            {relatedProducts.map(rp => (
              <ProductCard product={rp} />
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>


  /* Product Section */
  .single-product-wrap {
    padding: 36px 0 40px;
    background: #ffffff;
  }
  .product-inner-grid {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 45px;
    align-items: stretch;
  }

  /* Left Image Box */
  .single-image-box {
    position: relative;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 40px 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
  }
  .img-badge-trust {
    position: absolute;
    top: 14px;
    left: 14px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    color: #16a34a;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 999px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
  }
  .main-prod-img img {
    max-height: 380px;
    max-width: 100%;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.12));
    transition: transform 0.3s ease;
  }
  .single-image-box:hover .main-prod-img img {
    transform: scale(1.03);
  }

  /* Right Details Box */
  .single-details-box {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* Top Meta Tags */
  .product-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }
  .meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11.5px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    text-decoration: none;
  }
  .brand-pill {
    background: #0f172a;
    color: #ffffff;
    transition: background 0.15s ease;
  }
  .brand-pill:hover {
    background: #d97706;
    color: #ffffff;
  }
  .visc-pill {
    background: #f1f5f9;
    color: #334155;
    border: 1px solid #e2e8f0;
  }
  .stock-pill {
    background: #f0fdf4;
    color: #15803d;
    border: 1px solid #bbf7d0;
  }

  .single-title {
    font-size: 26px;
    font-weight: 800;
    color: #0f172a;
    margin: 4px 0 10px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .single-short-desc {
    font-size: 14.5px;
    color: #475569;
    line-height: 1.55;
    margin: 0 0 16px 0;
  }

  /* Quick Specs Summary Bar */
  .product-specs-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 12px 16px;
    margin-bottom: 20px;
  }
  .spec-summary-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .ss-label {
    font-size: 11px;
    color: #64748b;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .ss-value {
    font-size: 13.5px;
    color: #0f172a;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* CTA Buttons Wrapper */
  .cta-buttons-wrap {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 20px;
  }

  /* WhatsApp Button - Full width primary */
  .cta-btn-wa {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    background: #25d366;
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    padding: 0 24px;
    height: 52px;
    border-radius: 9px;
    text-decoration: none;
    box-sizing: border-box;
    transition: background 0.15s, transform 0.15s;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.25);
  }
  .cta-btn-wa:hover {
    background: #20ba59;
    color: #ffffff;
    transform: translateY(-1px);
  }

  /* Secondary 2-button row */
  .cta-secondary-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    align-items: stretch;
  }

  /* Call Button */
  .cta-btn-call,
  .cta-btn-detail {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 48px;
    font-size: 14.5px;
    font-weight: 700;
    border-radius: 9px;
    text-decoration: none;
    box-sizing: border-box;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .cta-btn-call {
    background: #0f172a;
    color: #ffffff;
    border: none;
  }
  .cta-btn-call:hover {
    background: #1e293b;
    color: #ffffff;
  }

  .cta-btn-detail {
    background: #ffffff;
    color: #0f172a;
    border: 1.5px solid #cbd5e1;
  }
  .cta-btn-detail:hover {
    border-color: #f59e0b;
    color: #d97706;
  }

  /* Technical Documents */
  .tech-docs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: auto;
    margin-bottom: 0;
  }
  .doc-download-pill {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 14px;
    min-height: 54px;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 9px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .doc-download-pill:hover {
    border-color: #f59e0b;
    background: #ffffff;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
    transform: translateY(-1px);
  }
  .doc-icon {
    font-size: 18px;
    color: #dc2626;
    flex-shrink: 0;
  }
  .doc-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    min-width: 0;
  }
  .doc-info strong {
    font-size: 12.5px;
    font-weight: 700;
    color: #1e293b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .doc-info small {
    font-size: 10.5px;
    color: #64748b;
    white-space: nowrap;
  }
  .doc-dl-icon {
    font-size: 11px;
    color: #94a3b8;
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .doc-download-pill:hover .doc-dl-icon {
    color: #d97706;
    transform: translateY(1px);
  }

  /* Share Row - removed from HTML, keeping minimal CSS */

  /* Long Desc */
  .product-long-desc-section {
    padding: 20px 0 50px;
    background: #ffffff;
  }
  .desc-divider {
    height: 1px;
    background: #e2e8f0;
    margin-bottom: 30px;
  }
  .desc-heading {
    font-size: 22px;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 14px;
    letter-spacing: -0.01em;
  }
  .desc-text-body p {
    font-size: 15px;
    color: #475569;
    line-height: 1.8;
    margin-bottom: 20px;
  }
  .desc-text-body h3 {
    font-size: 18px;
    font-weight: 700;
    color: #0f172a;
    margin-top: 25px;
    margin-bottom: 12px;
  }
  .desc-text-body ul {
    margin: 0 0 22px 20px;
    padding: 0;
    list-style: disc;
  }
  .desc-text-body li {
    font-size: 14.5px;
    color: #475569;
    line-height: 1.7;
    margin-bottom: 8px;
  }
  .desc-text-body li strong {
    color: #0f172a;
  }

  .orig-specs-table {
    width: 100%;
    max-width: 600px;
    border-collapse: collapse;
    margin-bottom: 40px;
  }
  .orig-specs-table td {
    padding: 10px 14px;
    border: 1px solid #e2e8f0;
    font-size: 13.5px;
  }
  .orig-specs-table tr:nth-child(even) {
    background: #f8fafc;
  }

  /* Related */
  .related-block {
    margin-top: 48px;
    padding-top: 10px;
  }
  .section-heading {
    font-size: 24px;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }
  .section-divider-line {
    height: 1px;
    background: #f1f5f9;
    margin-bottom: 24px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  @media (max-width: 992px) {
    .product-inner-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }

  @media (max-width: 640px) {
    .cta-secondary-row {
      grid-template-columns: 1fr;
    }
    .tech-docs-grid {
      grid-template-columns: 1fr;
    }
    .product-specs-summary {
      grid-template-columns: 1fr 1fr;
    }
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
  }
</style>
