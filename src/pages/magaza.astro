---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import products from '../data/products.json';
import siteConfig from '../data/siteConfig.json';

const brands = [
  { key: 'artoil', label: 'Artoil' },
  { key: 'castrol', label: 'Castrol' },
  { key: 'mobil', label: 'Mobil' },
  { key: 'petrol-ofisi', label: 'Petrol Ofisi' },
  { key: 'shell', label: 'Shell' }
];

// Viscosities sorted numerically
const viscosities = Array.from(new Set(products.map(p => p.viscosity))).sort((a, b) => {
  const numA = parseInt(a.replace(/\D/g, '')) || 0;
  const numB = parseInt(b.replace(/\D/g, '')) || 0;
  return numA - numB;
});

// Package types
const packageTypes = Array.from(new Set(products.map(p => p.packageType))).filter(Boolean);
---

<Layout
  title={`Tüm Hidrolik Yağları & Ürün Kataloğu | ${siteConfig.siteName}`}
  description="Artoil, Castrol, Mobil, Petrol Ofisi ve Shell kızak yağı çeşitleri. ISO VG 32, 46, 68, 100 viskozite seçenekleri, 16L teneke ve 208L varil toptan fiyatları."
>
  <!-- Shop CollectionPage Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Endüstriyel Hidrolik Yağları Kataloğu",
    "description": "Artoil, Castrol, Mobil, Petrol Ofisi ve Shell kızak yağı çeşitleri.",
    "url": `${siteConfig.domain}/magaza`,
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": products.length,
      "itemListElement": products.slice(0, 30).map((p, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": p.name,
        "url": `${siteConfig.domain}/urun/${p.id}`,
        "image": p.image
      }))
    }
  })} />

  <Breadcrumb items={[{ label: "Tüm Ürünler / Mağaza" }]} />

  <section class="shop-hero">
    <div class="container">
      <div class="shop-hero-inner">
        <span class="badge-amber">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          Ürün Kataloğu
        </span>
        <h1>Endüstriyel Hidrolik Yağları</h1>
        <p>
          Türkiye'nin lider madeni yağ markalarının orijinal ambalajlı kızak yağları. Fabrika dolumları ve perakende ihtiyaçlarınız için faturalı aynı gün sevkiyat.
        </p>
      </div>
    </div>
  </section>

  <!-- Mobile Drawer Backdrop (Outside the layout container) -->
  <div class="sidebar-backdrop" id="shop-sidebar-backdrop"></div>

  <section class="shop-section">
    <div class="container">
      <div class="shop-layout">
        
        <!-- Left Filter Sidebar -->
        <aside class="shop-sidebar" id="shop-sidebar">
          <div class="sidebar-mobile-header">
            <div class="sidebar-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
              Filtreler
            </div>
            <button class="sidebar-close-btn" id="shop-sidebar-close" type="button" aria-label="Kapat">&times;</button>
          </div>

          <!-- Search Widget -->
          <div class="filter-widget">
            <h4 class="widget-title">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
              Ürün Ara
            </h4>
            <div class="filter-search-box">
              <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
              <input
                type="text"
                id="shop-search-input"
                placeholder="Ürün adı veya viskozite..."
                autocomplete="off"
              />
              <button type="button" class="search-clear-btn" id="shop-search-clear" style="display:none;" aria-label="Temizle">&times;</button>
            </div>
          </div>

          <!-- Brand Filter -->
          <div class="filter-widget">
            <div class="widget-header">
              <h4 class="widget-title">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                Markaya Göre
              </h4>
              <button type="button" class="widget-reset-btn" id="reset-brand" style="display:none;">Temizle</button>
            </div>
            <ul class="filter-list" id="brand-filter-list">
              <li class="filter-item">
                <label class="filter-label">
                  <input type="radio" name="shop-brand" value="all" checked />
                  <span class="custom-radio"></span>
                  <span class="filter-text">Tüm Markalar</span>
                  <span class="filter-count">({products.length})</span>
                </label>
              </li>
              {brands.map((b) => {
                const count = products.filter(p => p.brand === b.key).length;
                return (
                  <li class="filter-item">
                    <label class="filter-label">
                      <input type="radio" name="shop-brand" value={b.key} />
                      <span class="custom-radio"></span>
                      <span class="filter-text">{b.label}</span>
                      <span class="filter-count">({count})</span>
                    </label>
                  </li>
                );
              })}
            </ul>
          </div>

          <!-- Viscosity Filter -->
          <div class="filter-widget">
            <div class="widget-header">
              <h4 class="widget-title">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
                Viskozite (ISO VG)
              </h4>
              <button type="button" class="widget-reset-btn" id="reset-viscosity" style="display:none;">Temizle</button>
            </div>
            <ul class="filter-list" id="viscosity-filter-list">
              <li class="filter-item">
                <label class="filter-label">
                  <input type="radio" name="shop-viscosity" value="all" checked />
                  <span class="custom-radio"></span>
                  <span class="filter-text">Tümü</span>
                  <span class="filter-count">({products.length})</span>
                </label>
              </li>
              {viscosities.map((visc) => {
                const count = products.filter(p => p.viscosity === visc).length;
                return (
                  <li class="filter-item">
                    <label class="filter-label">
                      <input type="radio" name="shop-viscosity" value={visc} />
                      <span class="custom-radio"></span>
                      <span class="filter-text">{visc}</span>
                      <span class="filter-count">({count})</span>
                    </label>
                  </li>
                );
              })}
            </ul>
          </div>

          <!-- Package Filter -->
          {packageTypes.length > 1 && (
            <div class="filter-widget">
              <div class="widget-header">
                <h4 class="widget-title">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                  Ambalaj Tipi
                </h4>
                <button type="button" class="widget-reset-btn" id="reset-package" style="display:none;">Temizle</button>
              </div>
              <ul class="filter-list" id="package-filter-list">
                <li class="filter-item">
                  <label class="filter-label">
                    <input type="radio" name="shop-package" value="all" checked />
                    <span class="custom-radio"></span>
                    <span class="filter-text">Tümü</span>
                    <span class="filter-count">({products.length})</span>
                  </label>
                </li>
                {packageTypes.map((pkg) => {
                  const count = products.filter(p => p.packageType === pkg).length;
                  return (
                    <li class="filter-item">
                      <label class="filter-label">
                        <input type="radio" name="shop-package" value={pkg} />
                        <span class="custom-radio"></span>
                        <span class="filter-text">{pkg}</span>
                        <span class="filter-count">({count})</span>
                      </label>
                    </li>
                  );
                })}
              </ul>
            </div>
          )}

          <!-- Sidebar Promo Box -->
          <div class="sidebar-promo-card">
            <div class="promo-badge">Toptan İskonto</div>
            <h5>Toplu Alım Desteği</h5>
            <p>Fabrika ve atölyeler için palet ve varil bazında özel fiyat listesi talep edin.</p>
            <a
              href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent('[kizakyagi.com] TOPTAN FIYAT LISTESI TALEBI\n\nMerhaba, fabrika ve atolyemiz icin hidrolik yaglarinda toptan iskonto ve fiyat listesi talep ediyorum.')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-sidebar-wa"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 18.07c-1.52 0-3-.4-4.3-1.17l-.31-.18-3.19.84.85-3.11-.2-.32c-.85-1.36-1.3-2.94-1.3-4.57 0-4.7 3.83-8.53 8.54-8.53 2.28 0 4.42.89 6.03 2.5 1.61 1.61 2.5 3.75 2.5 6.03 0 4.71-3.83 8.53-8.52 8.53zm4.68-6.39c-.26-.13-1.52-.75-1.76-.84-.23-.09-.4-.13-.57.13-.17.26-.66.84-.81 1.01-.15.17-.3.19-.56.06-.26-.13-1.08-.4-2.06-1.27-.76-.68-1.28-1.52-1.43-1.78-.15-.26-.02-.4.11-.53.12-.11.26-.3.39-.45.13-.15.17-.26.26-.43.09-.17.04-.32-.02-.45-.06-.13-.57-1.38-.79-1.89-.21-.5-.42-.43-.57-.44l-.49-.01c-.17 0-.45.06-.68.32-.23.26-.89.87-.89 2.12 0 1.25.91 2.46 1.04 2.63.13.17 1.8 2.75 4.36 3.86.61.26 1.09.42 1.46.54.61.2 1.17.17 1.61.1.49-.07 1.52-.62 1.74-1.22.21-.6.21-1.12.15-1.22-.06-.1-.23-.17-.49-.3z"/></svg>
              WhatsApp'tan Danış
            </a>
          </div>

          <!-- Mobile Apply Button -->
          <div class="sidebar-mobile-footer">
            <button class="btn-apply-filters" id="shop-apply-filters" type="button">
              Sonuçları Gör (<span id="mobile-count">{products.length}</span>)
            </button>
          </div>
        </aside>

        <!-- Main Content Area -->
        <main class="shop-main">
          <!-- Top Toolbar -->
          <div class="shop-top-bar">
            <div class="top-bar-left">
              <button class="btn-mobile-filter" id="shop-mobile-trigger" type="button">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                <span>Filtrele</span>
                <span class="filter-badge" id="shop-filter-badge" style="display:none;"></span>
              </button>
              <div class="shop-results-info">
                Toplam <strong id="visible-count">{products.length}</strong> ürün listeleniyor
              </div>
            </div>

            <div class="top-bar-right">
              <div class="sort-select-wrap">
                <label for="shop-sort">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m3 16 4 4 4-4"/><path d="M7 20V4"/><path d="m21 8-4-4-4 4"/><path d="M17 4v16"/></svg>
                </label>
                <select id="shop-sort">
                  <option value="default">Varsayılan Sıralama</option>
                  <option value="name-asc">Ürün Adı: A - Z</option>
                  <option value="name-desc">Ürün Adı: Z - A</option>
                  <option value="visc-asc">Viskozite: Düşükten Yükseğe</option>
                  <option value="visc-desc">Viskozite: Yüksekten Düşüğe</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Active Filters Row -->
          <div class="active-filters-row" id="active-filters-row" style="display: none;">
            <span class="active-label">Seçili:</span>
            <div class="active-tags-list" id="active-tags-list"></div>
            <button class="btn-clear-all" id="btn-clear-all" type="button">Tümünü Temizle</button>
          </div>

          <!-- No Results State -->
          <div class="no-results-state" id="no-results-state" style="display: none;">
            <div class="no-results-icon">
              <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/><path d="M8 11h6"/></svg>
            </div>
            <h3>Filtrelere Uygun Ürün Bulunamadı</h3>
            <p>Arama terimini değiştirebilir veya filtreleri sıfırlayarak tüm ürünleri inceleyebilirsiniz.</p>
            <button class="btn-reset-all" id="btn-reset-all" type="button">Filtreleri Sıfırla</button>
          </div>

          <!-- Products Grid (3 cols on desktop) -->
          <div class="shop-products-grid" id="shop-products-grid">
            {products.map((p, index) => (
              <div
                class="shop-card"
                data-index={index}
                data-brand={p.brand}
                data-name={p.name.toLowerCase()}
                data-viscosity={p.viscosity}
                data-package={p.packageType}
                data-visc-num={parseInt(p.viscosity.replace(/\D/g, '')) || 0}
              >
                <a href={`/urun/${p.id}`} class="shop-card-img-wrap">
                  <img src={p.image} alt={p.name} loading="lazy" />
                </a>

                <div class="shop-card-body">
                  <div class="shop-card-meta">
                    <span class="brand-badge">{p.brandName}</span>
                    <span class="visc-pill">{p.viscosity}</span>
                  </div>

                  <h3 class="shop-card-title">
                    <a href={`/urun/${p.id}`}>{p.name}</a>
                  </h3>

                  <div class="shop-card-actions">
                    <a href={`/urun/${p.id}`} class="btn-detail">İncele</a>
                    <a
                      href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(`[kizakyagi.com] TEKLIF TALEBI\n\nUrun: ${p.name}\n\nMerhaba, bu urun icin guncel toptan ve perakende fiyat teklifi rica ediyorum.`)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-quote"
                    >
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 18.07c-1.52 0-3-.4-4.3-1.17l-.31-.18-3.19.84.85-3.11-.2-.32c-.85-1.36-1.3-2.94-1.3-4.57 0-4.7 3.83-8.53 8.54-8.53 2.28 0 4.42.89 6.03 2.5 1.61 1.61 2.5 3.75 2.5 6.03 0 4.71-3.83 8.53-8.52 8.53zm4.68-6.39c-.26-.13-1.52-.75-1.76-.84-.23-.09-.4-.13-.57.13-.17.26-.66.84-.81 1.01-.15.17-.3.19-.56.06-.26-.13-1.08-.4-2.06-1.27-.76-.68-1.28-1.52-1.43-1.78-.15-.26-.02-.4.11-.53.12-.11.26-.3.39-.45.13-.15.17-.26.26-.43.09-.17.04-.32-.02-.45-.06-.13-.57-1.38-.79-1.89-.21-.5-.42-.43-.57-.44l-.49-.01c-.17 0-.45.06-.68.32-.23.26-.89.87-.89 2.12 0 1.25.91 2.46 1.04 2.63.13.17 1.8 2.75 4.36 3.86.61.26 1.09.42 1.46.54.61.2 1.17.17 1.61.1.49-.07 1.52-.62 1.74-1.22.21-.6.21-1.12.15-1.22-.06-.1-.23-.17-.49-.3z"/></svg>
                      Teklif Al
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </main>
      </div>
    </div>
  </section>
</Layout>

<script>
  // DOM References
  const searchInput = document.getElementById('shop-search-input') as HTMLInputElement | null;
  const searchClearBtn = document.getElementById('shop-search-clear') as HTMLButtonElement | null;
  const brandRadios = document.querySelectorAll<HTMLInputElement>('input[name="shop-brand"]');
  const viscRadios = document.querySelectorAll<HTMLInputElement>('input[name="shop-viscosity"]');
  const pkgRadios = document.querySelectorAll<HTMLInputElement>('input[name="shop-package"]');
  const sortSelect = document.getElementById('shop-sort') as HTMLSelectElement | null;

  const resetBrandBtn = document.getElementById('reset-brand') as HTMLButtonElement | null;
  const resetViscBtn = document.getElementById('reset-viscosity') as HTMLButtonElement | null;
  const resetPkgBtn = document.getElementById('reset-package') as HTMLButtonElement | null;
  const clearAllBtn = document.getElementById('btn-clear-all') as HTMLButtonElement | null;
  const resetAllEmptyBtn = document.getElementById('btn-reset-all') as HTMLButtonElement | null;

  const countDisplay = document.getElementById('visible-count');
  const mobileCountDisplay = document.getElementById('mobile-count');
  const filterBadge = document.getElementById('shop-filter-badge');
  const activeFiltersRow = document.getElementById('active-filters-row');
  const activeTagsList = document.getElementById('active-tags-list');
  const noResultsState = document.getElementById('no-results-state');

  const productsGrid = document.getElementById('shop-products-grid') as HTMLElement | null;
  const allCards = Array.from(document.querySelectorAll<HTMLElement>('#shop-products-grid .shop-card'));

  // Mobile Drawer
  const mobileFilterBtn = document.getElementById('shop-mobile-trigger');
  const sidebarCloseBtn = document.getElementById('shop-sidebar-close');
  const sidebarApplyBtn = document.getElementById('shop-apply-filters');
  const sidebarBackdrop = document.getElementById('shop-sidebar-backdrop');
  const shopSidebar = document.getElementById('shop-sidebar');

  // Filter State
  let currentSearch = '';
  let currentBrand = 'all';
  let currentViscosity = 'all';
  let currentPackage = 'all';
  let currentSort = 'default';

  function applyFilterAndSort() {
    let visibleCount = 0;
    let activeFilterCount = 0;

    if (currentSearch) activeFilterCount++;
    if (currentBrand !== 'all') activeFilterCount++;
    if (currentViscosity !== 'all') activeFilterCount++;
    if (currentPackage !== 'all') activeFilterCount++;

    if (resetBrandBtn) resetBrandBtn.style.display = currentBrand !== 'all' ? 'inline-block' : 'none';
    if (resetViscBtn) resetViscBtn.style.display = currentViscosity !== 'all' ? 'inline-block' : 'none';
    if (resetPkgBtn) resetPkgBtn.style.display = currentPackage !== 'all' ? 'inline-block' : 'none';
    if (searchClearBtn) searchClearBtn.style.display = currentSearch ? 'block' : 'none';

    if (filterBadge) {
      if (activeFilterCount > 0) {
        filterBadge.textContent = activeFilterCount.toString();
        filterBadge.style.display = 'inline-flex';
      } else {
        filterBadge.style.display = 'none';
      }
    }

    if (activeFiltersRow && activeTagsList) {
      if (activeFilterCount > 0) {
        activeFiltersRow.style.display = 'flex';
        activeTagsList.innerHTML = '';

        if (currentSearch) {
          const tag = document.createElement('span');
          tag.className = 'active-filter-tag';
          tag.innerHTML = `"${currentSearch}" <button type="button">&times;</button>`;
          tag.querySelector('button')?.addEventListener('click', () => {
            if (searchInput) searchInput.value = '';
            currentSearch = '';
            applyFilterAndSort();
          });
          activeTagsList.appendChild(tag);
        }

        if (currentBrand !== 'all') {
          const brandRadio = Array.from(brandRadios).find(r => r.value === currentBrand);
          const brandText = brandRadio?.closest('.filter-label')?.querySelector('.filter-text')?.textContent || currentBrand;
          const tag = document.createElement('span');
          tag.className = 'active-filter-tag';
          tag.innerHTML = `${brandText} <button type="button">&times;</button>`;
          tag.querySelector('button')?.addEventListener('click', () => {
            selectBrand('all');
          });
          activeTagsList.appendChild(tag);
        }

        if (currentViscosity !== 'all') {
          const tag = document.createElement('span');
          tag.className = 'active-filter-tag';
          tag.innerHTML = `${currentViscosity} <button type="button">&times;</button>`;
          tag.querySelector('button')?.addEventListener('click', () => {
            selectViscosity('all');
          });
          activeTagsList.appendChild(tag);
        }

        if (currentPackage !== 'all') {
          const tag = document.createElement('span');
          tag.className = 'active-filter-tag';
          tag.innerHTML = `${currentPackage} <button type="button">&times;</button>`;
          tag.querySelector('button')?.addEventListener('click', () => {
            selectPackage('all');
          });
          activeTagsList.appendChild(tag);
        }
      } else {
        activeFiltersRow.style.display = 'none';
      }
    }

    const visibleCards: HTMLElement[] = [];
    allCards.forEach(card => {
      const brand = card.getAttribute('data-brand') || '';
      const name = card.getAttribute('data-name') || '';
      const visc = card.getAttribute('data-viscosity') || '';
      const pkg = card.getAttribute('data-package') || '';

      const matchSearch = !currentSearch || name.includes(currentSearch) || visc.toLowerCase().includes(currentSearch) || brand.includes(currentSearch);
      const matchBrand = (currentBrand === 'all') || (brand === currentBrand);
      const matchVisc = (currentViscosity === 'all') || (visc === currentViscosity);
      const matchPkg = (currentPackage === 'all') || (pkg === currentPackage);

      if (matchSearch && matchBrand && matchVisc && matchPkg) {
        card.style.display = 'flex';
        visibleCards.push(card);
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (currentSort !== 'default' && productsGrid) {
      visibleCards.sort((a, b) => {
        const nameA = a.getAttribute('data-name') || '';
        const nameB = b.getAttribute('data-name') || '';
        const viscA = parseInt(a.getAttribute('data-visc-num') || '0', 10);
        const viscB = parseInt(b.getAttribute('data-visc-num') || '0', 10);

        if (currentSort === 'name-asc') return nameA.localeCompare(nameB, 'tr');
        if (currentSort === 'name-desc') return nameB.localeCompare(nameA, 'tr');
        if (currentSort === 'visc-asc') return viscA - viscB;
        if (currentSort === 'visc-desc') return viscB - viscA;
        return 0;
      });

      visibleCards.forEach(c => productsGrid.appendChild(c));
    }

    if (countDisplay) countDisplay.textContent = visibleCount.toString();
    if (mobileCountDisplay) mobileCountDisplay.textContent = visibleCount.toString();
    if (noResultsState) noResultsState.style.display = visibleCount === 0 ? 'flex' : 'none';
  }

  function selectBrand(val: string) {
    currentBrand = val;
    brandRadios.forEach(radio => {
      radio.checked = (radio.value === val);
    });
    applyFilterAndSort();
  }

  function selectViscosity(val: string) {
    currentViscosity = val;
    viscRadios.forEach(radio => {
      radio.checked = (radio.value === val);
    });
    applyFilterAndSort();
  }

  function selectPackage(val: string) {
    currentPackage = val;
    pkgRadios.forEach(radio => {
      radio.checked = (radio.value === val);
    });
    applyFilterAndSort();
  }

  function resetAll() {
    currentSearch = '';
    if (searchInput) searchInput.value = '';
    selectBrand('all');
    selectViscosity('all');
    selectPackage('all');
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
      applyFilterAndSort();
    });
  }

  if (searchClearBtn) {
    searchClearBtn.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      currentSearch = '';
      applyFilterAndSort();
    });
  }

  brandRadios.forEach(radio => {
    radio.addEventListener('change', () => {
      if (radio.checked) {
        currentBrand = radio.value;
        applyFilterAndSort();
      }
    });
  });

  viscRadios.forEach(radio => {
    radio.addEventListener('change', () => {
      if (radio.checked) {
        currentViscosity = radio.value;
        applyFilterAndSort();
      }
    });
  });

  pkgRadios.forEach(radio => {
    radio.addEventListener('change', () => {
      if (radio.checked) {
        currentPackage = radio.value;
        applyFilterAndSort();
      }
    });
  });

  if (sortSelect) {
    sortSelect.addEventListener('change', () => {
      currentSort = sortSelect.value;
      applyFilterAndSort();
    });
  }

  if (resetBrandBtn) resetBrandBtn.addEventListener('click', () => selectBrand('all'));
  if (resetViscBtn) resetViscBtn.addEventListener('click', () => selectViscosity('all'));
  if (resetPkgBtn) resetPkgBtn.addEventListener('click', () => selectPackage('all'));
  if (clearAllBtn) clearAllBtn.addEventListener('click', resetAll);
  if (resetAllEmptyBtn) resetAllEmptyBtn.addEventListener('click', resetAll);

  // Mobile Drawer Toggle
  function openMobileSidebar() {
    if (shopSidebar) shopSidebar.classList.add('open');
    if (sidebarBackdrop) sidebarBackdrop.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeMobileSidebar() {
    if (shopSidebar) shopSidebar.classList.remove('open');
    if (sidebarBackdrop) sidebarBackdrop.classList.remove('open');
    document.body.style.overflow = '';
  }

  if (mobileFilterBtn) mobileFilterBtn.addEventListener('click', openMobileSidebar);
  if (sidebarCloseBtn) sidebarCloseBtn.addEventListener('click', closeMobileSidebar);
  if (sidebarBackdrop) sidebarBackdrop.addEventListener('click', closeMobileSidebar);
  if (sidebarApplyBtn) sidebarApplyBtn.addEventListener('click', closeMobileSidebar);
</script>

