---
import siteConfig from '../data/siteConfig.json';
import products from '../data/products.json';
import '../styles/global.css';

const artoilProducts = products.filter(p => p.brand === 'artoil');
const castrolProducts = products.filter(p => p.brand === 'castrol');
const mobilProducts = products.filter(p => p.brand === 'mobil');
const poProducts = products.filter(p => p.brand === 'petrol-ofisi');
const shellProducts = products.filter(p => p.brand === 'shell');

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title = `${siteConfig.siteName} - Güçlü Performans, Sorunsuz Çalışma!`,
  description = siteConfig.metaDescription,
  ogImage,
  canonical
} = Astro.props;

// Absolute canonical URL always points to production domain for SEO
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteConfig.domain).href;

// Absolute OG image URL always points to production domain for rich social cards (WhatsApp, Twitter, Google)
const defaultOgImage = `${siteConfig.domain}/images/logo-v2.png`;
const rawOgImage = ogImage || defaultOgImage;
const resolvedOgImage = rawOgImage.startsWith('http') ? rawOgImage : new URL(rawOgImage, siteConfig.domain).href;
