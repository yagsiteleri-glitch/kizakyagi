        {
          "@type": ["Organization", "LocalBusiness"],
          "@id": `${siteConfig.domain}/#organization`,
          "name": siteConfig.siteName,
          "url": siteConfig.domain,
          "logo": `${siteConfig.domain}/images/logo-v2.png`,
          "image": `${siteConfig.domain}/images/logo-v2.png`,
