---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from './Breadcrumb.astro';
import products from '../data/products.json';
import siteConfig from '../data/siteConfig.json';

interface Props {
  brandKey: string;
  brandName: string;
  brandLogo?: string;
  heroTitle: string;
  heroDesc: string;
  metaDesc: string;
}

const { brandKey, brandName, brandLogo, heroTitle, heroDesc, metaDesc } = Astro.props;

// Filter products for this brand
const brandProducts = products.filter(p => p.brand === brandKey);

// Get unique viscosities for filter (sorted numerically)
const viscosities = Array.from(new Set(brandProducts.map(p => p.viscosity))).sort((a, b) => {
  const numA = parseInt(a.replace(/\D/g, '')) || 0;
  const numB = parseInt(b.replace(/\D/g, '')) || 0;
  return numA - numB;
});

// Get unique package types
const packageTypes = Array.from(new Set(brandProducts.map(p => p.packageType))).filter(Boolean);

const allBrandsList = [
  { key: 'artoil', name: 'Artoil', href: '/artoil' },
  { key: 'castrol', name: 'Castrol', href: '/castrol' },
  { key: 'mobil', name: 'Mobil', href: '/mobil' },
  { key: 'petrol-ofisi', name: 'Petrol Ofisi', href: '/petrol-ofisi' },
  { key: 'shell', name: 'Shell', href: '/shell' }
];
---

<Layout
  title={`${brandName} Hidrolik Yağları Fiyatları & Çeşitleri | ${siteConfig.siteName}`}
  description={metaDesc}
>
  <!-- CollectionPage & ItemList Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": `${brandName} Hidrolik Yağları`,
    "description": metaDesc,
    "url": `${siteConfig.domain}/${brandKey}`,
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": brandProducts.length,
      "itemListElement": brandProducts.map((p, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": p.name,
        "url": `${siteConfig.domain}/urun/${p.id}`,
        "image": p.image
      }))
    }
  })} />

  <!-- Breadcrumb -->
  <Breadcrumb
    items={[
      { label: "Tüm Ürünler", href: "/magaza" },
      { label: `${brandName} Hidrolik Yağları` }
    ]}
  />

  <!-- Brand Hero Banner -->
  <header class="brand-hero">
    <div class="container brand-hero-inner">
      <div class="brand-hero-content">
        <div class="brand-meta-tag">
          <span class="dot"></span> Yetkili Satış & Toptan Dağıtım
        </div>
        <h1>{heroTitle}</h1>
        <p class="brand-lead">{heroDesc}</p>
        <div class="brand-hero-badges">
          <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg> Faturalı %100 Orijinal Ürün</span>
          <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg> TDS & MSDS Teknik Belgeli</span>
          <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg> İstanbul İçi Aynı Gün & Türkiye Geneli Ambar</span>
        </div>
      </div>
      {brandLogo && (
        <div class="brand-hero-logo-box">
          <img src={brandLogo} alt={`${brandName} Logo`} class="brand-hero-logo" />
        </div>
      )}
    </div>
  </header>

  <!-- Mobile Drawer Backdrop -->
  <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

  <!-- Product Listing Section with Sidebar -->
  <section class="brand-catalog-section">
    <div class="container">
      <div class="catalog-layout">
        
        <!-- Left Filter Sidebar -->
        <aside class="catalog-sidebar" id="catalog-sidebar">
          <div class="sidebar-mobile-header">
            <div class="sidebar-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
              Filtreler
            </div>
            <button class="sidebar-close-btn" id="sidebar-close-btn" type="button" aria-label="Kapat">&times;</button>
          </div>

          <!-- Filter Search Box -->
          <div class="filter-widget">
            <h4 class="widget-title">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
              Ürün Ara
            </h4>
            <div class="filter-search-box">
              <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
              <input
                type="text"
                id="catalog-search"
                placeholder={`${brandName} içinde ara...`}
                autocomplete="off"
              />
              <button type="button" class="search-clear-btn" id="search-clear" style="display:none;" aria-label="Aramayı Temizle">&times;</button>
            </div>
          </div>

          <!-- Viscosity Filter -->
          <div class="filter-widget">
            <div class="widget-header">
              <h4 class="widget-title">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
                Viskozite (ISO VG)
              </h4>
              <button type="button" class="widget-reset-btn" id="reset-viscosity" style="display:none;">Temizle</button>
            </div>
            <ul class="filter-list" id="viscosity-filter-list">
              <li class="filter-item">
                <label class="filter-label">
                  <input type="radio" name="viscosity-filter" value="all" checked />
                  <span class="custom-radio"></span>
                  <span class="filter-text">Tümü</span>
                  <span class="filter-count">({brandProducts.length})</span>
                </label>
              </li>
              {viscosities.map((visc) => {
                const count = brandProducts.filter(p => p.viscosity === visc).length;
                return (
                  <li class="filter-item">
                    <label class="filter-label">
                      <input type="radio" name="viscosity-filter" value={visc} />
                      <span class="custom-radio"></span>
                      <span class="filter-text">{visc}</span>
                      <span class="filter-count">({count})</span>
                    </label>
                  </li>
                );
              })}
            </ul>
          </div>

          <!-- Package Type Filter -->
          {packageTypes.length > 1 && (
            <div class="filter-widget">
              <div class="widget-header">
                <h4 class="widget-title">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                  Ambalaj Tipi
                </h4>
                <button type="button" class="widget-reset-btn" id="reset-package" style="display:none;">Temizle</button>
              </div>
              <ul class="filter-list" id="package-filter-list">
                <li class="filter-item">
                  <label class="filter-label">
                    <input type="radio" name="package-filter" value="all" checked />
                    <span class="custom-radio"></span>
                    <span class="filter-text">Tümü</span>
                    <span class="filter-count">({brandProducts.length})</span>
                  </label>
                </li>
                {packageTypes.map((pkg) => {
                  const count = brandProducts.filter(p => p.packageType === pkg).length;
                  return (
                    <li class="filter-item">
                      <label class="filter-label">
                        <input type="radio" name="package-filter" value={pkg} />
                        <span class="custom-radio"></span>
                        <span class="filter-text">{pkg}</span>
                        <span class="filter-count">({count})</span>
                      </label>
                    </li>
                  );
                })}
              </ul>
            </div>
          )}

          <!-- Brand Navigation Widget -->
          <div class="filter-widget brands-widget">
            <h4 class="widget-title">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
              Tüm Markalar
            </h4>
            <ul class="brand-nav-list">
              {allBrandsList.map(b => (
                <li>
                  <a href={b.href} class={b.key === brandKey ? 'active-brand' : ''}>
                    <span>{b.name}</span>
                    {b.key === brandKey ? (
                      <span class="brand-current-tag">Seçili</span>
                    ) : (
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- B2B Support Promo Box -->
          <div class="sidebar-promo-card">
            <div class="promo-badge">Toptan & Sanayi</div>
            <h5>Özel Fiyat Teklifi</h5>
            <p>Varil ve toplu teneke alımları için teknik temsilcimizden anında iskonto alın.</p>
            <a
              href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(`[hidrolikyag.com] TOPTAN FIYAT LISTESI: ${brandName}\n\nMerhaba, ${brandName} hidrolik yaglari toptan fiyat listesi ve stok durumunu ogrenmek istiyorum.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-sidebar-wa"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 18.07c-1.52 0-3-.4-4.3-1.17l-.31-.18-3.19.84.85-3.11-.2-.32c-.85-1.36-1.3-2.94-1.3-4.57 0-4.7 3.83-8.53 8.54-8.53 2.28 0 4.42.89 6.03 2.5 1.61 1.61 2.5 3.75 2.5 6.03 0 4.71-3.83 8.53-8.52 8.53zm4.68-6.39c-.26-.13-1.52-.75-1.76-.84-.23-.09-.4-.13-.57.13-.17.26-.66.84-.81 1.01-.15.17-.3.19-.56.06-.26-.13-1.08-.4-2.06-1.27-.76-.68-1.28-1.52-1.43-1.78-.15-.26-.02-.4.11-.53.12-.11.26-.3.39-.45.13-.15.17-.26.26-.43.09-.17.04-.32-.02-.45-.06-.13-.57-1.38-.79-1.89-.21-.5-.42-.43-.57-.44l-.49-.01c-.17 0-.45.06-.68.32-.23.26-.89.87-.89 2.12 0 1.25.91 2.46 1.04 2.63.13.17 1.8 2.75 4.36 3.86.61.26 1.09.42 1.46.54.61.2 1.17.17 1.61.1.49-.07 1.52-.62 1.74-1.22.21-.6.21-1.12.15-1.22-.06-.1-.23-.17-.49-.3z"/></svg>
              WhatsApp'tan Danış
            </a>
          </div>

          <!-- Mobile Apply Button -->
          <div class="sidebar-mobile-footer">
            <button class="btn-apply-filters" id="btn-apply-filters" type="button">
              Sonuçları Gör (<span id="mobile-count">{brandProducts.length}</span>)
            </button>
          </div>
        </aside>

        <!-- Main Product Grid & Content -->
        <main class="catalog-main">
          <!-- Top Toolbar -->
          <div class="catalog-top-bar">
            <div class="top-bar-left">
              <button class="btn-mobile-filter" id="btn-mobile-filter" type="button">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                <span>Filtrele</span>
                <span class="filter-badge" id="filter-badge" style="display:none;"></span>
              </button>
              <div class="catalog-count-text">
                Toplam <strong id="visible-count">{brandProducts.length}</strong> ürün listeleniyor
              </div>
            </div>

            <div class="top-bar-right">
              <div class="sort-select-wrap">
                <label for="catalog-sort">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m3 16 4 4 4-4"/><path d="M7 20V4"/><path d="m21 8-4-4-4 4"/><path d="M17 4v16"/></svg>
                </label>
                <select id="catalog-sort">
                  <option value="default">Varsayılan Sıralama</option>
                  <option value="name-asc">Ürün Adı: A - Z</option>
                  <option value="name-desc">Ürün Adı: Z - A</option>
                  <option value="visc-asc">Viskozite: Düşükten Yükseğe</option>
                  <option value="visc-desc">Viskozite: Yüksekten Düşüğe</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Active Filter Pills (Shown when user applied any filter) -->
          <div class="active-filters-row" id="active-filters-row" style="display: none;">
            <span class="active-label">Seçili:</span>
            <div class="active-tags-list" id="active-tags-list"></div>
            <button class="btn-clear-all" id="btn-clear-all" type="button">Tümünü Temizle</button>
          </div>

          <!-- No Results Box -->
          <div class="no-results-state" id="no-results-state" style="display: none;">
            <div class="no-results-icon">
              <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/><path d="M8 11h6"/></svg>
            </div>
            <h3>Filtrelere Uygun Ürün Bulunamadı</h3>
            <p>Arama terimini değiştirebilir veya filtreleri sıfırlayarak tüm {brandName} ürünlerini inceleyebilirsiniz.</p>
            <button class="btn-reset-all" id="btn-reset-all" type="button">Filtreleri Sıfırla</button>
          </div>

          <!-- Products Grid -->
          <div class="products-grid" id="products-grid">
            {brandProducts.map((p, index) => (
              <div
                class="b2b-product-card"
                data-index={index}
                data-name={p.name.toLowerCase()}
                data-viscosity={p.viscosity}
                data-package={p.packageType}
                data-visc-num={parseInt(p.viscosity.replace(/\D/g, '')) || 0}
              >
                <a href={`/urun/${p.id}`} class="card-img-wrap">
                  <img src={p.image} alt={p.name} loading="lazy" />
                </a>
                <div class="card-body">
                  <div class="card-meta">
                    <span class="card-brand">{p.brandName}</span>
                    <span class="card-visc">{p.viscosity}</span>
                  </div>
                  <h3 class="card-title">
                    <a href={`/urun/${p.id}`}>{p.name}</a>
                  </h3>
                  <div class="card-actions">
                    <a href={`/urun/${p.id}`} class="btn-card-detail">İncele</a>
                    <a
                      href={`https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(`[hidrolikyag.com] TEKLIF TALEBI\n\nUrun: ${p.name}\n\nMerhaba, bu urun icin guncel toptan ve perakende fiyat teklifi rica ediyorum.`)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-card-quote"
                    >
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 18.07c-1.52 0-3-.4-4.3-1.17l-.31-.18-3.19.84.85-3.11-.2-.32c-.85-1.36-1.3-2.94-1.3-4.57 0-4.7 3.83-8.53 8.54-8.53 2.28 0 4.42.89 6.03 2.5 1.61 1.61 2.5 3.75 2.5 6.03 0 4.71-3.83 8.53-8.52 8.53zm4.68-6.39c-.26-.13-1.52-.75-1.76-.84-.23-.09-.4-.13-.57.13-.17.26-.66.84-.81 1.01-.15.17-.3.19-.56.06-.26-.13-1.08-.4-2.06-1.27-.76-.68-1.28-1.52-1.43-1.78-.15-.26-.02-.4.11-.53.12-.11.26-.3.39-.45.13-.15.17-.26.26-.43.09-.17.04-.32-.02-.45-.06-.13-.57-1.38-.79-1.89-.21-.5-.42-.43-.57-.44l-.49-.01c-.17 0-.45.06-.68.32-.23.26-.89.87-.89 2.12 0 1.25.91 2.46 1.04 2.63.13.17 1.8 2.75 4.36 3.86.61.26 1.09.42 1.46.54.61.2 1.17.17 1.61.1.49-.07 1.52-.62 1.74-1.22.21-.6.21-1.12.15-1.22-.06-.1-.23-.17-.49-.3z"/></svg>
                      Teklif Al
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <!-- B2B Bulk Order Banner -->
          <div class="bulk-quote-card">
            <div class="bulk-text">
              <h3>Toptan Varil & Palet Siparişleri İçin Özel İskonto</h3>
              <p>Yüksek hacimli fabrika dolumları ve periyodik madeni yağ tedarik anlaşmaları için satış temsilcimizle görüşün.</p>
            </div>
            <div class="bulk-actions">
              <a href={`tel:${siteConfig.phoneRaw}`} class="btn-phone">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                {siteConfig.phone}
              </a>
              <a href="/teklif-al" class="btn-quote">Teklif Formu Doldur</a>
            </div>
          </div>
        </main>
      </div>
    </div>
  </section>
</Layout>

<script>
  // DOM Elements
  const searchInput = document.getElementById('catalog-search') as HTMLInputElement | null;
  const searchClearBtn = document.getElementById('search-clear') as HTMLButtonElement | null;
  const viscRadios = document.querySelectorAll<HTMLInputElement>('input[name="viscosity-filter"]');
  const pkgRadios = document.querySelectorAll<HTMLInputElement>('input[name="package-filter"]');
  const sortSelect = document.getElementById('catalog-sort') as HTMLSelectElement | null;
  
  const resetViscBtn = document.getElementById('reset-viscosity') as HTMLButtonElement | null;
  const resetPkgBtn = document.getElementById('reset-package') as HTMLButtonElement | null;
  const clearAllBtn = document.getElementById('btn-clear-all') as HTMLButtonElement | null;
  const resetAllEmptyBtn = document.getElementById('btn-reset-all') as HTMLButtonElement | null;

  const countDisplay = document.getElementById('visible-count');
  const mobileCountDisplay = document.getElementById('mobile-count');
  const filterBadge = document.getElementById('filter-badge');
  const activeFiltersRow = document.getElementById('active-filters-row');
  const activeTagsList = document.getElementById('active-tags-list');
  const noResultsState = document.getElementById('no-results-state');

  const productsGrid = document.getElementById('products-grid') as HTMLElement | null;
  const allCards = Array.from(document.querySelectorAll<HTMLElement>('#products-grid .b2b-product-card'));

  // Mobile Drawer Elements
  const mobileFilterBtn = document.getElementById('btn-mobile-filter');
  const sidebarCloseBtn = document.getElementById('sidebar-close-btn');
  const sidebarApplyBtn = document.getElementById('btn-apply-filters');
  const sidebarBackdrop = document.getElementById('sidebar-backdrop');
  const catalogSidebar = document.getElementById('catalog-sidebar');

  // Filter State
  let currentSearch = '';
  let currentViscosity = 'all';
  let currentPackage = 'all';
  let currentSort = 'default';

  function applyFilterAndSort() {
    let visibleCount = 0;
    let activeFilterCount = 0;

    if (currentSearch) activeFilterCount++;
    if (currentViscosity !== 'all') activeFilterCount++;
    if (currentPackage !== 'all') activeFilterCount++;

    if (resetViscBtn) resetViscBtn.style.display = currentViscosity !== 'all' ? 'inline-block' : 'none';
    if (resetPkgBtn) resetPkgBtn.style.display = currentPackage !== 'all' ? 'inline-block' : 'none';
    if (searchClearBtn) searchClearBtn.style.display = currentSearch ? 'block' : 'none';

    if (filterBadge) {
      if (activeFilterCount > 0) {
        filterBadge.textContent = activeFilterCount.toString();
        filterBadge.style.display = 'inline-flex';
      } else {
        filterBadge.style.display = 'none';
      }
    }

    if (activeFiltersRow && activeTagsList) {
      if (activeFilterCount > 0) {
        activeFiltersRow.style.display = 'flex';
        activeTagsList.innerHTML = '';

        if (currentSearch) {
          const tag = document.createElement('span');
          tag.className = 'active-filter-tag';
          tag.innerHTML = `"${currentSearch}" <button type="button">&times;</button>`;
          tag.querySelector('button')?.addEventListener('click', () => {
            if (searchInput) searchInput.value = '';
            currentSearch = '';
            applyFilterAndSort();
          });
          activeTagsList.appendChild(tag);
        }

        if (currentViscosity !== 'all') {
          const tag = document.createElement('span');
          tag.className = 'active-filter-tag';
          tag.innerHTML = `${currentViscosity} <button type="button">&times;</button>`;
          tag.querySelector('button')?.addEventListener('click', () => {
            selectViscosity('all');
          });
          activeTagsList.appendChild(tag);
        }

        if (currentPackage !== 'all') {
          const tag = document.createElement('span');
          tag.className = 'active-filter-tag';
          tag.innerHTML = `${currentPackage} <button type="button">&times;</button>`;
          tag.querySelector('button')?.addEventListener('click', () => {
            selectPackage('all');
          });
          activeTagsList.appendChild(tag);
        }
      } else {
        activeFiltersRow.style.display = 'none';
      }
    }

    const visibleCards: HTMLElement[] = [];
    allCards.forEach(card => {
      const name = card.getAttribute('data-name') || '';
      const visc = card.getAttribute('data-viscosity') || '';
      const pkg = card.getAttribute('data-package') || '';

      const matchSearch = !currentSearch || name.includes(currentSearch) || visc.toLowerCase().includes(currentSearch);
      const matchVisc = currentViscosity === 'all' || visc === currentViscosity;
      const matchPkg = currentPackage === 'all' || pkg === currentPackage;

      if (matchSearch && matchVisc && matchPkg) {
        card.style.display = 'flex';
        visibleCards.push(card);
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (productsGrid && visibleCards.length > 0) {
      visibleCards.sort((a, b) => {
        if (currentSort === 'name-asc') {
          return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '', 'tr');
        } else if (currentSort === 'name-desc') {
          return (b.getAttribute('data-name') || '').localeCompare(a.getAttribute('data-name') || '', 'tr');
        } else if (currentSort === 'visc-asc') {
          const vA = parseInt(a.getAttribute('data-visc-num') || '0', 10);
          const vB = parseInt(b.getAttribute('data-visc-num') || '0', 10);
          return vA - vB;
        } else if (currentSort === 'visc-desc') {
          const vA = parseInt(a.getAttribute('data-visc-num') || '0', 10);
          const vB = parseInt(b.getAttribute('data-visc-num') || '0', 10);
          return vB - vA;
        } else {
          const idxA = parseInt(a.getAttribute('data-index') || '0', 10);
          const idxB = parseInt(b.getAttribute('data-index') || '0', 10);
          return idxA - idxB;
        }
      });

      visibleCards.forEach(card => productsGrid.appendChild(card));
    }

    if (countDisplay) countDisplay.textContent = visibleCount.toString();
    if (mobileCountDisplay) mobileCountDisplay.textContent = visibleCount.toString();

    if (noResultsState) {
      if (visibleCount === 0) {
        noResultsState.style.display = 'flex';
        if (productsGrid) productsGrid.style.display = 'none';
      } else {
        noResultsState.style.display = 'none';
        if (productsGrid) productsGrid.style.display = 'grid';
      }
    }
  }

  function selectViscosity(val: string) {
    currentViscosity = val;
    viscRadios.forEach(radio => {
      radio.checked = (radio.value === val);
    });
    applyFilterAndSort();
  }

  function selectPackage(val: string) {
    currentPackage = val;
    pkgRadios.forEach(radio => {
      radio.checked = (radio.value === val);
    });
    applyFilterAndSort();
  }

  function resetAll() {
    currentSearch = '';
    if (searchInput) searchInput.value = '';
    selectViscosity('all');
    selectPackage('all');
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
      applyFilterAndSort();
    });
  }

  if (searchClearBtn) {
    searchClearBtn.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      currentSearch = '';
      applyFilterAndSort();
    });
  }

  viscRadios.forEach(radio => {
    radio.addEventListener('change', () => {
      if (radio.checked) {
        currentViscosity = radio.value;
        applyFilterAndSort();
      }
    });
  });

  pkgRadios.forEach(radio => {
    radio.addEventListener('change', () => {
      if (radio.checked) {
        currentPackage = radio.value;
        applyFilterAndSort();
      }
    });
  });

  if (sortSelect) {
    sortSelect.addEventListener('change', () => {
      currentSort = sortSelect.value;
      applyFilterAndSort();
    });
  }

  if (resetViscBtn) resetViscBtn.addEventListener('click', () => selectViscosity('all'));
  if (resetPkgBtn) resetPkgBtn.addEventListener('click', () => selectPackage('all'));
  if (clearAllBtn) clearAllBtn.addEventListener('click', resetAll);
  if (resetAllEmptyBtn) resetAllEmptyBtn.addEventListener('click', resetAll);

  function openMobileSidebar() {
    if (catalogSidebar) catalogSidebar.classList.add('open');
    if (sidebarBackdrop) sidebarBackdrop.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeMobileSidebar() {
    if (catalogSidebar) catalogSidebar.classList.remove('open');
    if (sidebarBackdrop) sidebarBackdrop.classList.remove('open');
    document.body.style.overflow = '';
  }

  if (mobileFilterBtn) mobileFilterBtn.addEventListener('click', openMobileSidebar);
  if (sidebarCloseBtn) sidebarCloseBtn.addEventListener('click', closeMobileSidebar);
  if (sidebarBackdrop) sidebarBackdrop.addEventListener('click', closeMobileSidebar);
  if (sidebarApplyBtn) sidebarApplyBtn.addEventListener('click', closeMobileSidebar);
</script>

